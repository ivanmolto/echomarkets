# EchoMarkets server configuration
# Copy to .env.local (local) and set the same vars in Vercel. Never commit real values.

# Solana wallet that receives USDC payments
NEXT_PUBLIC_RECEIVER_ADDRESS=your_solana_wallet_address

# x402 v1 network name: solana-devnet (testing) or solana (mainnet).
# Note: it is "solana", not "solana-mainnet-beta".
NEXT_PUBLIC_NETWORK=solana-devnet

# Devnet only: public testnet facilitator. Ignored when NEXT_PUBLIC_NETWORK=solana.
NEXT_PUBLIC_FACILITATOR_URL=https://x402.org/facilitator

# Mainnet only: CDP secret API key, used by @coinbase/x402 to authenticate to the
# CDP facilitator (https://portal.cdp.coinbase.com → API keys → Secret API key).
# Server-side secrets — never prefix with NEXT_PUBLIC_.
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret

# HMAC key for 24h /api/signal bearer tokens: openssl rand -hex 32
SIGNAL_SECRET=your_hmac_key_for_signal_bearer_tokens

# Public base URL used in generated templates and links
NEXT_PUBLIC_BASE_URL=https://www.example.com  

# Optional: X post with the demo video (shown on the landing)
NEXT_PUBLIC_X_POST=https://x.com/your_username/status/your_post_id
